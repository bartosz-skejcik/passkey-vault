/target
**/*.rs.bk
/data
.env
web/.env.local
node_modules/
.next/
dist/
.DS_Store

# WASM build artifacts (generated by scripts/build-wasm.sh)
web/src/lib/crypto/wasm/
web/public/wasm/
extension/lib/crypto/wasm/
extension/public/wasm/

# Next.js static export output (web/node_modules/ and web/.next/ already
# covered by the bare node_modules/ and .next/ patterns above)
web/out/

# TypeScript incremental build cache
web/tsconfig.tsbuildinfo

# verify-container.sh repo-local scratch (certs/Caddyfile for proxy E2E)
.verify-scratch.*
.verify-tmp/

# Xcode per-user state and build output (ios/). xcuserdata holds window
# positions and scheme ordering — machine-local noise, never shared.
xcuserdata/
*.xcuserstate
DerivedData/
ios/**/build/
