# Reference .env for docker-compose.yml. Copy to .env and customize for a
# real deployment: `cp .env.example .env`.
#
# PV_RP_ID and PV_ORIGIN must be changed TOGETHER for any real
# (non-localhost) deployment — an incoherent pair makes pv-server refuse to
# start. See docs/SELF-HOSTING.md for the full explanation and examples.

# WebAuthn Relying Party ID — must equal PV_ORIGIN's host or be its
# registrable parent domain, e.g. PV_RP_ID=example.com with
# PV_ORIGIN=https://vault.example.com.
PV_RP_ID=localhost

# Full origin URL the browser sees, including scheme. Must be https:// for
# any non-localhost deployment (every real browser rejects a non-localhost
# http:// WebAuthn origin at ceremony time).
PV_ORIGIN=http://localhost:8620

# Session token lifetime, in hours.
PV_SESSION_TTL_HOURS=168

# NOTE: PV_DB_URL, PV_ADDR, and PV_STATIC_DIR are intentionally NOT listed
# here as overridable — they're baked directly into docker-compose.yml for
# the packaged deployment. Overriding them (e.g. reverting PV_ADDR back to
# 127.0.0.1:8620) would make the container unreachable from the host.
