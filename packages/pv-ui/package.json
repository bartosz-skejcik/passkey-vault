{
  "name": "pv-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design tokens + generator logic for web/ and extension/ (D-13, plan 11-07). First-party, source-only — no build step; consumers transpile it as their own source.",
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens.css",
