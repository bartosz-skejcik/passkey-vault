    "./generator/strength": {
      "types": "./generator/strength.ts",
      "default": "./generator/strength.ts"
    },
    "./generator/wordlist": {
      "types": "./generator/wordlist.ts",
      "default": "./generator/wordlist.ts"
    }
  }
}
